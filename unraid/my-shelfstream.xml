<?xml version="1.0"?>
<Container version="2">
  <Name>shelfstream</Name>
  <Repository>ghcr.io/matthewcarberry/shelf:latest</Repository>
  <Registry>https://github.com/matthewcarberry/shelf/pkgs/container/shelf</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/matthewcarberry/shelf/issues</Support>
  <Project>https://shelf-stream.com</Project>
  <Overview>Self-hosted ebook and audiobook library, reader, and player.</Overview>
  <Category>MediaServer:Books</Category>
  <WebUI>http://[IP]:[PORT:3000]</WebUI>
  <Icon>https://raw.githubusercontent.com/matthewcarberry/shelf/main/unraid/shelf-icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <Config Name="WebUI Port" Target="3000" Default="9191" Mode="tcp" Description="Shelf web interface port." Type="Port" Display="always" Required="true" Mask="false">9191</Config>
  <Config Name="Library" Target="/library" Default="/mnt/user/media/books" Mode="rw" Description="Ebook and audiobook library." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/media/books</Config>
  <Config Name="Application Data" Target="/data" Default="/mnt/user/appdata/shelfstream" Mode="rw" Description="Shelf database and application data." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/shelfstream</Config>
  <Config Name="Application Port" Target="PORT" Default="3000" Mode="" Description="Internal application port." Type="Variable" Display="advanced" Required="true" Mask="false">3000</Config>
  <Config Name="Server Name" Target="SERVER_NAME" Default="Shelf" Mode="" Description="Name shown to clients when this server is claimed or discovered." Type="Variable" Display="always" Required="true" Mask="false">Shelf</Config>
  <Config Name="Public URL" Target="PUBLIC_URL" Default="https://shelf-stream.com" Mode="" Description="Verified HTTPS address used by Shelf account clients and server switching." Type="Variable" Display="always" Required="true" Mask="false">https://shelf-stream.com</Config>
  <Config Name="Library Directory" Target="LIBRARY_DIR" Default="/library" Mode="" Description="Library path inside the container." Type="Variable" Display="advanced" Required="true" Mask="false">/library</Config>
  <Config Name="Data Directory" Target="DATA_DIR" Default="/data" Mode="" Description="Application data path inside the container." Type="Variable" Display="advanced" Required="true" Mask="false">/data</Config>
  <Config Name="Online Dictionary" Target="ONLINE_DICTIONARY" Default="true" Mode="" Description="Enable online dictionary lookup." Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>
  <Config Name="Authentication" Target="AUTH_ENABLED" Default="true" Mode="" Description="Require Shelf authentication." Type="Variable" Display="always" Required="true" Mask="false">true</Config>
  <Config Name="Application Username" Target="APP_USERNAME" Default="admin" Mode="" Description="Initial Shelf administrator username." Type="Variable" Display="always" Required="true" Mask="false">admin</Config>
  <Config Name="Application Password" Target="APP_PASSWORD" Default="" Mode="" Description="Initial administrator password when a password hash is not supplied." Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Application Password Hash" Target="APP_PASSWORD_HASH" Default="" Mode="" Description="Preferred hashed administrator password." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Trust Proxy" Target="TRUST_PROXY" Default="false" Mode="" Description="Trust reverse-proxy forwarding headers." Type="Variable" Display="advanced" Required="true" Mask="false">false</Config>
  <Config Name="Secure Cookies" Target="COOKIE_SECURE" Default="false" Mode="" Description="Require HTTPS cookies." Type="Variable" Display="advanced" Required="true" Mask="false">false</Config>
  <Config Name="Registration" Target="REGISTRATION_ENABLED" Default="true" Mode="" Description="Allow user registration." Type="Variable" Display="always" Required="true" Mask="false">true</Config>
  <Config Name="Registration Email Notification" Target="REGISTRATION_REQUIRE_EMAIL_NOTIFY" Default="true" Mode="" Description="Notify the configured address about registrations." Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>
  <Config Name="Registration Notification Address" Target="REGISTRATION_NOTIFY_EMAIL" Default="" Mode="" Description="Recipient for registration notifications." Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Registration Attempts" Target="REGISTRATION_MAX_ATTEMPTS" Default="5" Mode="" Description="Maximum registration attempts." Type="Variable" Display="advanced" Required="true" Mask="false">5</Config>
  <Config Name="SMTP Host" Target="SMTP_HOST" Default="" Mode="" Description="Outgoing mail server." Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="SMTP Port" Target="SMTP_PORT" Default="587" Mode="" Description="Outgoing mail server port." Type="Variable" Display="advanced" Required="false" Mask="false">587</Config>
  <Config Name="SMTP Secure" Target="SMTP_SECURE" Default="false" Mode="" Description="Use an implicit TLS SMTP connection." Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="SMTP Username" Target="SMTP_USER" Default="" Mode="" Description="Outgoing mail username." Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="SMTP Password" Target="SMTP_PASS" Default="" Mode="" Description="Outgoing mail password." Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Email From" Target="EMAIL_FROM" Default="" Mode="" Description="Sender address for Shelf email." Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Kindle Attachment Limit" Target="KINDLE_MAX_ATTACHMENT_MB" Default="25" Mode="" Description="Maximum Send to Kindle attachment size in MB." Type="Variable" Display="advanced" Required="true" Mask="false">25</Config>
</Container>
