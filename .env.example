PORT=3000
SHELFSTREAM_HOST_PORT=9191
# Image tag from ghcr.io/matthewcarberry/shelf: latest, a release such as 0.1.0, or sha-abc1234.
SHELF_IMAGE_TAG=latest
LIBRARY_DIR=./runtime/library
DATA_DIR=./runtime/data
ONLINE_DICTIONARY=true
AUTH_ENABLED=true
APP_USERNAME=admin
APP_PASSWORD=change-this-password
# APP_PASSWORD_HASH=scrypt:...
TRUST_PROXY=true
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
REGISTRATION_REQUIRE_EMAIL_NOTIFY=true
REGISTRATION_NOTIFY_EMAIL=you@example.com
REGISTRATION_MAX_ATTEMPTS=5
# SMTP is required for email notifications.
# For Gmail, use smtp.gmail.com, port 587, and an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-sending-account@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=Shelf <your-sending-account@gmail.com>
# Maximum EPUB attachment size for Send to Kindle. Keep this within your SMTP provider's limit.
KINDLE_MAX_ATTACHMENT_MB=25
